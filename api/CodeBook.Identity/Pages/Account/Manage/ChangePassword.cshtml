@page
@model CodeBook.Identity.Pages.Account.Manage.ChangePassword

<div class="login-page">
    <div class="lead">
        <h1>Change password</h1>
        <p>Update your account password</p>
    </div>

    <partial name="_ValidationSummary" />

    <div class="row">
        <div class="col-sm-6">
            <div class="card">
                <div class="card-header">
                    <h2>New password</h2>
                </div>

                <div class="card-body">
                    @if (Model.Succeeded)
                    {
                        <div class="alert alert-success">
                            Your password has been changed successfully.
                        </div>
                        <a class="btn btn-primary" href="@Model.GetReturnUrl()">Back to profile</a>
                    }
                    else
                    {
                        <form asp-page="/Account/Manage/ChangePassword" method="post">
                            <div class="form-group">
                                <label asp-for="Input.CurrentPassword"></label>
                                <input type="password" class="form-control" placeholder="Current password" asp-for="Input.CurrentPassword" autofocus autocomplete="current-password">
                            </div>

                            <div class="form-group">
                                <label asp-for="Input.NewPassword"></label>
                                <input type="password" class="form-control" placeholder="New password" asp-for="Input.NewPassword" autocomplete="new-password">
                            </div>

                            <div class="form-group">
                                <label asp-for="Input.ConfirmPassword"></label>
                                <input type="password" class="form-control" placeholder="Confirm new password" asp-for="Input.ConfirmPassword" autocomplete="new-password">
                            </div>

                            <button class="btn btn-primary" type="submit">Save password</button>
                            <a class="btn btn-link" href="@Model.GetReturnUrl()">Cancel</a>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
