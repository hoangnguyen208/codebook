@page
@model CodeBook.Identity.Pages.Account.ResetPassword.Confirmation

<div class="login-page">
    <div class="lead">
        <h1>Password updated</h1>
        <p>Your password has been changed successfully.</p>
    </div>

    <div class="row">
        <div class="col-sm-6">
            <div class="card">
                <div class="card-body">
                    <p>You can now sign in with your new password.</p>
                    <a class="btn btn-primary" href="@Model.SignInUrl">Sign in</a>
                </div>
            </div>
        </div>
    </div>
</div>
